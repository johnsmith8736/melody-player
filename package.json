{
  "name": "melody-player",
  "version": "1.0.0",
  "description": "Modern Spotify-inspired desktop music player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dist": "electron-builder --linux pacman"
  },
  "keywords": [
    "music",
    "player",
    "electron",
    "spotify"
  ],
  "author": "Alex <alex@example.com>",
  "license": "MIT",
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "level": "^10.0.0",
    "music-metadata": "^7.14.0"
  },
  "build": {
    "appId": "com.alex.melody-player",
    "productName": "Melody",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "linux": {
      "target": "pacman",
      "category": "Audio",
      "icon": "icon.png",
      "maintainer": "Alex <alex@example.com>"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "preload.js",
      "icon.png",
      "package.json",
      "node_modules/music-metadata/**/*",
      "node_modules/level/**/*",
      "node_modules/classic-level/**/*"
    ],
    "asar": true,
    "extraResources": []
  },
  "allowScripts": {
    "electron@37": true
  }
}
